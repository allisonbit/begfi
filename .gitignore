# Secrets. .env.local holds the Supabase service role key, which bypasses RLS —
# committing it would expose every row in the BegFi schema and the auth users.
.env
.env.local
.env.*.local
.env.production
.env.development

# Dependencies
node_modules/

# Next.js
web/.next/
web/out/
web/next-env.d.ts

# TypeScript incremental build state. Changes on every build, belongs to nobody.
*.tsbuildinfo

# Hardhat
artifacts/
cache/
typechain-types/

# Vercel
.vercel

# Editor / OS
.DS_Store
Thumbs.db

# Explainer video (video/README.md). The script and the tooling are committed;
# the rendered artefacts are minutes of video and hundreds of PNGs, and the venv
# holds a bundled ffmpeg binary. Regenerate with the four commands in the README.
video/.venv/
video/shots/
video/audio/
video/build/
video/begfi-explainer.mp4
*.log
