# Contract deployment environment. Copy to `.env` (gitignored) and fill in.
#
# `.env` is refused by the pre-commit hook both by name and by content, so a key
# in it cannot be committed. Keeping the key here rather than exporting it in a
# shell also keeps it out of shell history, out of `ps`, and out of the scrollback
# of whatever terminal ran the deploy.

# The wallet that deploys. For `npm run deploy:local` this is unnecessary — the
# local node funds its own accounts. It is required for `npm run deploy:mainnet`,
# and that wallet pays real gas.
#
#   BEG_DEPLOYER_KEY=0x<64 hex>
#
# A key on this line is a key that can move every asset that wallet holds. Use a
# wallet created for deploying and funded with only the gas it needs — not your
# main wallet, and not one holding anything else.
BEG_DEPLOYER_KEY=

# RPC overrides. Leave both unset for the public endpoints.
BEG_RPC_URL=
BEG_LOCAL_RPC_URL=
