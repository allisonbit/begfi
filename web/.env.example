# BegFi environment.
#
# Copy to `.env.local` and fill in. Never commit `.env.local`.
#
# The two sections marked REQUIRED are what the app cannot do anything without.
# Everything else degrades to an honest "not configured yet" state rather than a
# broken-looking control — see lib/config.ts, which validates every address and
# resolves a bad one to null rather than to a string that would fail later.

# ---------------------------------------------------------------------------
# Supabase — REQUIRED
# ---------------------------------------------------------------------------
# Project spgijqgogjugqtjtvunb, shared with cosmic-oracle-charts; BegFi's tables
# live in the `begfi` schema, not `public`.
#
# IMPORTANT: after running supabase/migrations, add `begfi` under
# Settings -> API -> Exposed schemas in the Supabase dashboard. Without it,
# PostgREST answers 404 for every call no matter how the RLS is written.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role. Server-only — it bypasses RLS, so it must never reach the
# browser bundle. Used by the indexer and the sign-in routes. (Not NEXT_PUBLIC_,
# deliberately: that prefix is what inlines a value into client JS.)
SUPABASE_SERVICE_ROLE_KEY=


# ---------------------------------------------------------------------------
# Wallet sign-in — REQUIRED
# ---------------------------------------------------------------------------
# Signs the nonce cookie. Any random string of 16+ characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Falls back to the service role key if unset, which works but couples two
# secrets that are better rotated independently.
WALLET_AUTH_SECRET=


# ---------------------------------------------------------------------------
# Chain and contracts
# ---------------------------------------------------------------------------
# Leave unset for Robinhood Chain mainnet.
#
# To develop against a local node, run `npx hardhat node` at the repo root (it
# runs at chainId 4663, the same as mainnet) and set:
#   NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
#   NEXT_PUBLIC_BEG_TOKEN_ADDRESS=<TestToken address from the local deploy>
NEXT_PUBLIC_RPC_URL=

# The $BEG token. LEAVE THIS EMPTY until $BEG has actually been launched
# (spec §9.4). While it is empty the app treats sending as not-yet-available and
# says so, rather than rendering a send button for a token that does not exist.
NEXT_PUBLIC_BEG_TOKEN_ADDRESS=


# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Where this deployment is served. Used for absolute URLs in Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The prefix shown in the link field. Kept separate from SITE_URL because the
# product domain (begfi.xyz) is not owned yet, and copy that claims a domain the
# app is not served from would misstate where a link actually goes. Defaults to
# SITE_URL.
NEXT_PUBLIC_LINK_ORIGIN=


# ---------------------------------------------------------------------------
# Indexer
# ---------------------------------------------------------------------------
# Shared secret for /api/cron/indexer. Vercel sends
# `Authorization: Bearer $CRON_SECRET` on scheduled invocations; the route
# refuses anything else, so the endpoint cannot be used to make the app do
# unbounded RPC work.
CRON_SECRET=

# Block to start scanning from. Leave empty to scan from the token's deployment
# block — which the indexer resolves once and stores in `begfi.app_config`
# rather than re-deriving on every run.
BEG_INDEX_FROM_BLOCK=


# ---------------------------------------------------------------------------
# Contracts (repo root, not the web app)
# ---------------------------------------------------------------------------
# Only needed to deploy, and only ever in the shell that deploys. Not part of
# the Next build.
#
# BEG_DEPLOYER_KEY=
# BEG_RPC_URL=
