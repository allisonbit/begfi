# RainbowKit 2.2.11 declares a peer of wagmi ^2.9.0, and this project is on
# wagmi 3. Rather than the reverse of bug-protocol's situation, this is the
# simpler half of it: no import in this app touches the APIs that changed between
# wagmi 2 and 3, and bug-protocol runs the same RainbowKit 2.2.11 against wagmi
# 3.7.7 in production.
#
# The alternative was staying on wagmi 2.19.5 to satisfy the peer honestly, and
# that was tried first. It fails the build: on the wagmi 2 tree,
# @wagmi/connectors pulls in @base-org/account, which pulls in @coinbase/cdp-sdk,
# which imports @x402/svm/exact/client — a Solana package that is neither
# installed nor used. wagmi 3's connector set does not take that path.
#
# So the peer range is unsatisfied on purpose, and the thing that actually
# matters is the build: it passes here exactly as it passes in bug-protocol.
#
# Scoped to this project rather than passed as a flag, so a local install and a
# Vercel install resolve identically. A build that passes locally and fails on
# the deploy is a worse failure than the peer warning this silences.
legacy-peer-deps=true
